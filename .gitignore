# Environment Variables (CRITICAL: Keeps your passwords and API keys safe)
.env*

# AI Coding Assistant Settings (keep commands/ for project slash commands)
.claude/*
!.claude/commands/
.antigravitycli/

# Scraped Data Output (Ignores timestamped files, keeps latest.json)
padsplit_scraper/output/202*.json
padsplit_scraper/output/drafts.json
padsplit_scraper/output/drafted_messages.json
thermostat/output/202*.json
thermostat/temp_alert_state.json


# Python Virtual Environment & Cache
venv/
__pycache__/
*.pyc

# Runtime logs
logs/

*.log
padsplit_scraper/output/latest.json

# Discord runtime state (regenerated each run, not checked in)
docs/data/discord_digest_meta.json
docs/data/processed_replies.json
