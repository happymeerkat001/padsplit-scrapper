# Example unit for a Linux host (Ubuntu 24.04). Not used by Mac launchd.
# /opt/padsplit is a placeholder for the git checkout. No secrets, no hostnames.
# Credentials and send gates live in /etc/padsplit/.env (EnvironmentFile).
# Shadow run: set PADSPLIT_NO_PUSH=1 in that file and leave every *_ENABLE unset.
[Unit]
Description=PadSplit morning scrape
After=network-online.target
Wants=network-online.target
OnFailure=padsplit-onfailure@%p.service

[Service]
Type=oneshot
User=padsplit
Group=padsplit
WorkingDirectory=/opt/padsplit
Environment=PADSPLIT_WORKSPACE=/opt/padsplit
Environment=PADSPLIT_ENV_FILE=/etc/padsplit/.env
EnvironmentFile=/etc/padsplit/.env
ExecStart=/opt/padsplit/run_morning.sh
