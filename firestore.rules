rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Ang keeps access via angCodesUid(). Extra uids go in approvedCodesUids().
    // Leave that list empty until Ang adds them. An empty list matches nobody.
    function angCodesUid() {
      return '8jOJNgLoxpfyseZ0RY1PDZ1DXbi2';
    }
    function approvedCodesUids() {
      return [];
    }
    function isApprovedCodesUser() {
      return request.auth != null
        && (
          request.auth.uid == angCodesUid()
          || request.auth.uid in approvedCodesUids()
        );
    }
    match /property_codes/{slug} {
      allow read, write: if isApprovedCodesUser();
      match /code_versions/{id} {
        allow get: if isApprovedCodesUser();
        allow list: if isApprovedCodesUser()
          && request.query.limit != null
          && request.query.limit <= 50;
        allow create: if isApprovedCodesUser()
          && request.resource.data.keys().hasOnly(['fields', 'contentHash', 'createdAt', 'expireAt', 'source']);
        allow update, delete: if false;
      }
    }
    match /notes/codes {
      allow read, write: if isApprovedCodesUser();
    }
    match /notes/{document} {
      allow read: if document != 'codes';
      allow write: if document != 'codes'
        && request.auth.uid == '8jOJNgLoxpfyseZ0RY1PDZ1DXbi2';
    }
    match /task_messages/{id} {
      allow read: if true;
      allow write: if request.auth.uid == '8jOJNgLoxpfyseZ0RY1PDZ1DXbi2';
    }
    match /manual_tasks/{id} {
      allow read: if true;
      allow write: if request.auth.uid == '8jOJNgLoxpfyseZ0RY1PDZ1DXbi2';
    }
    match /vendors/{id} {
      allow read, write: if isApprovedCodesUser();
    }
    // templates/shared stays world-readable. Booking and leak reply fetch it
    // with unauthenticated REST. Writes stay on Ang's uid.
    match /templates/{document} {
      allow read: if true;
      allow write: if request.auth.uid == '8jOJNgLoxpfyseZ0RY1PDZ1DXbi2';
    }
    match /stats/{document} {
      allow read, write: if isApprovedCodesUser();
    }
    // Scraper Admin SDK writes private_pages. Approved clients may read.
    // Client creates, updates, and deletes are denied.
    match /private_pages/{document=**} {
      allow read: if isApprovedCodesUser();
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
