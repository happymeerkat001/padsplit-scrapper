rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One approved Codes uid (Joe). Leave the return empty until Ang fills it.
    // Empty matches nobody: property_codes, code_versions, and notes/codes fail closed.
    function approvedCodesUid() {
      return '';
    }
    function isApprovedCodesUser() {
      return request.auth != null
        && approvedCodesUid() != ''
        && request.auth.uid == approvedCodesUid();
    }
    match /property_codes/{slug} {
      allow read, write: if isApprovedCodesUser();
      match /code_versions/{id} {
        allow get: if isApprovedCodesUser();
        allow list: if isApprovedCodesUser()
          && request.query.limit != null
          && request.query.limit <= 50;
        allow create: if isApprovedCodesUser()
          && request.resource.data.keys().hasOnly(['fields', 'contentHash', 'createdAt', 'expireAt', 'source']);
        allow update, delete: if false;
      }
    }
    match /notes/codes {
      allow read, write: if isApprovedCodesUser();
    }
    match /notes/{document} {
      allow read: if document != 'codes';
      allow write: if document != 'codes'
        && request.auth.uid == '8jOJNgLoxpfyseZ0RY1PDZ1DXbi2';
    }
    match /task_messages/{id} {
      allow read: if true;
      allow write: if request.auth.uid == '8jOJNgLoxpfyseZ0RY1PDZ1DXbi2';
    }
    match /manual_tasks/{id} {
      allow read: if true;
      allow write: if request.auth.uid == '8jOJNgLoxpfyseZ0RY1PDZ1DXbi2';
    }
    match /vendors/{id} {
      allow read: if true;
      allow write: if request.auth.uid == '8jOJNgLoxpfyseZ0RY1PDZ1DXbi2';
    }
    match /templates/{document} {
      allow read: if true;
      allow write: if request.auth.uid == '8jOJNgLoxpfyseZ0RY1PDZ1DXbi2';
    }
    match /stats/{document} {
      allow read, write: if request.auth.uid == 'TXSU0LOpmDWNBbbv0x3uHHBnZb12';
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
