rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Ang keeps access via angCodesUid(). Extra uids go in approvedCodesUids().
    // Leave that list empty until Ang adds them. An empty list matches nobody.
    function angCodesUid() {
      return '8jOJNgLoxpfyseZ0RY1PDZ1DXbi2';
    }
    function approvedCodesUids() {
      return [];
    }
    function isApprovedCodesUser() {
      return request.auth != null
        && (
          request.auth.uid == angCodesUid()
          || request.auth.uid in approvedCodesUids()
        );
    }
    function notesTextOk() {
      return request.resource.data.keys().hasOnly(['text'])
        && request.resource.data.text is string
        && request.resource.data.text.size() < 20000;
    }
    function vendorFieldsOk() {
      return request.resource.data.keys().hasOnly(['name', 'specialty', 'contact', 'location'])
        && request.resource.data.name is string
        && request.resource.data.name.size() < 500
        && request.resource.data.specialty is string
        && request.resource.data.specialty.size() < 500
        && request.resource.data.contact is string
        && request.resource.data.contact.size() < 500
        && request.resource.data.location is string
        && request.resource.data.location.size() < 500;
    }
    match /property_codes/{slug} {
      allow read, write: if isApprovedCodesUser();
      match /code_versions/{id} {
        allow get: if isApprovedCodesUser();
        allow list: if isApprovedCodesUser()
          && request.query.limit != null
          && request.query.limit <= 50;
        allow create: if isApprovedCodesUser()
          && request.resource.data.keys().hasOnly(['fields', 'contentHash', 'createdAt', 'expireAt', 'source']);
        allow update, delete: if false;
      }
    }
    // notes/codes, templates, stats, dashboard, and messages are all { text }.
    // No server reader. Approved users may read and write; creates and updates
    // must be that one string, under 20000 characters.
    match /notes/{document} {
      allow read: if isApprovedCodesUser();
      allow delete: if isApprovedCodesUser();
      allow create, update: if isApprovedCodesUser() && notesTextOk();
    }
    // Dashboard task chat and manual tasks. The page starts these listeners
    // only after codes sign-in. The status monitor reads task_messages with
    // the Admin SDK, which bypasses these rules.
    match /task_messages/{id} {
      allow read, write: if isApprovedCodesUser();
    }
    match /manual_tasks/{id} {
      allow read, write: if isApprovedCodesUser();
    }
    match /vendors/{id} {
      allow read: if isApprovedCodesUser();
      allow delete: if isApprovedCodesUser();
      allow create, update: if isApprovedCodesUser() && vendorFieldsOk();
    }
    // templates/shared is an approved-user read. Booking and leak reply use
    // the Admin SDK, which bypasses these rules. Writes stay on Ang's uid.
    match /templates/{document} {
      allow read: if isApprovedCodesUser();
      allow write: if request.auth.uid == '8jOJNgLoxpfyseZ0RY1PDZ1DXbi2';
    }
    // Only the Admin SDK writes stats. Clients may read after codes sign-in.
    match /stats/{document} {
      allow read: if isApprovedCodesUser();
      allow write: if false;
    }
    // Scraper Admin SDK writes private_pages. Approved clients may read.
    // Client creates, updates, and deletes are denied.
    match /private_pages/{document=**} {
      allow read: if isApprovedCodesUser();
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
