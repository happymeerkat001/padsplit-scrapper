rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /property_codes/{slug} {
      allow read, write: if request.auth.uid == '8jOJNgLoxpfyseZ0RY1PDZ1DXbi2';
    }
    match /notes/{document} {
      allow read, write: if request.auth.uid == '8jOJNgLoxpfyseZ0RY1PDZ1DXbi2';
    }
    match /task_messages/{id} {
      allow read, write: if request.auth.uid == '8jOJNgLoxpfyseZ0RY1PDZ1DXbi2';
    }
    match /manual_tasks/{id} {
      allow read, write: if request.auth.uid == '8jOJNgLoxpfyseZ0RY1PDZ1DXbi2';
    }
    match /vendors/{id} {
      allow read, write: if request.auth.uid == '8jOJNgLoxpfyseZ0RY1PDZ1DXbi2';
    }
    match /templates/{document} {
      allow read, write: if request.auth.uid == '8jOJNgLoxpfyseZ0RY1PDZ1DXbi2';
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
